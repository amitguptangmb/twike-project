APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB database, loaded from the converted twike_mysql_schema.sql +
# twike_mysql_procs.sql (ported from the original SQL Server "ngmb" database -
# see MIGRATION_NOTES.md for exactly what did and didn't convert). Laravel
# still never runs its own migrations against this database - it only calls
# the converted stored procedures, same division of responsibility as before.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=twike
DB_USERNAME=twike
DB_PASSWORD=

# No longer used anywhere - kept only so nothing breaks if a future decision
# reverses the "leave passwords as plain text" call. MySQL has no equivalent
# to SQL Server's EncryptByPassPhrase, and the forgotPasswordUpdate proc that
# used it wasn't in the stored-procedure export, so it isn't ported either.
USER_RESET_PASSPHRASE=

# Local-only session/cache/queue so nothing Laravel-specific ever touches the
# twike SQL Server schema.
SESSION_DRIVER=file
SESSION_LIFETIME=20
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Same Gmail SMTP relay the old app used (Classes/mail.cs). The app password
# that was hardcoded there has been exposed in plaintext source for a long
# time - generate a NEW Gmail app password and put ONLY that here, never in
# a .cs/.php file.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@ngmbsoftwaresolution.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@twikesoftwaresolution.in"
MAIL_FROM_NAME="TWIKE"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
